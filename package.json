{
  "name": "dsh-plugin-hub",
  "version": "0.2.0",
  "description": "dsh web 的「插件集」面板：侧栏入口 + 左侧插件列表 / 右侧内容区，任何插件都可通过 window.__DSH_PLUGIN_HUB__.register 挂载自己的面板；并列出已安装插件清单。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  }
}
